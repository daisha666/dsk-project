# Google Sheets連携用の認証キー（秘密情報のためコミットしない）
config/google_credentials.json

# SQLiteデータベース本体（サイズが大きいためリポジトリに含めない）
database/dsk_project.db

# 学習済みモデル（train_model.pyで再生成できる。データ収集期間がまだ短く
# 頻繁に再学習する段階のため、バイナリをリポジトリに含めない）
model/*.pkl

# predict_race.pyの出力（実行のたびに再生成される中間ファイル。
# 実際の出力先はdocs/data/predictions.json。output/以下は過去バージョンの
# 名残・watcher.py等の運用ログ置き場のため丸ごと除外）
output/

# automation/watcher.pyのエラーログ
automation/logs/

__pycache__/
*.pyc
